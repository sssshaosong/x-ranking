{
  "name": "x-ranking",
  "version": "0.1.0",
  "private": true,
  "description": "多源热点异动监控，拐点检测 + Telegram 推送，运行在 Cloudflare Workers",
  "scripts": {
    "postinstall": "node scripts/prepare-cloudflare-config.mjs",
