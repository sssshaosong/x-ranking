    "preview": "tsx scripts/preview.ts",
    "deploy": "wrangler deploy --no-x-provision"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "undici": "^8.10.0",
    "wrangler": "^4.45.0"
  }
}
